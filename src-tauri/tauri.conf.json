{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PG CSV Exporter",
  "version": "0.2.0",
  "identifier": "jp.kazuki.pgcsv",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title": "PG CSV Exporter", "width": 1080, "height": 800, "minWidth": 820, "minHeight": 620}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active": false}
}
